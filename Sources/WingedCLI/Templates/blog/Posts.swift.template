import Foundation

/// The posts, newest first. Each one becomes a page at `/posts/<slug>/` and a feed entry.
struct Post {
    let slug: String
    let title: String
    let summary: String
    let date: Date
    let tags: [String]
    let paragraphs: [String]
}

enum Posts {
    static let all = [
        Post(slug: "hello-world",
             title: "Hello, world",
             summary: "The first post on {{SITE_TITLE}}.",
             date: day("{{TODAY}}"),
             tags: ["meta"],
             paragraphs: [
                "This blog is generated from Swift with WingedSwift.",
                "Add a post by appending to Posts.all — it gets a page, a sitemap entry and a feed item."
             ])
    ]

    static func day(_ isoDate: String) -> Date {
        ISO8601DateFormatter().date(from: isoDate + "T00:00:00Z") ?? Date(timeIntervalSince1970: 0)
    }

    static func display(_ date: Date) -> String {
        let formatter = DateFormatter()
        formatter.locale = Locale(identifier: "{{SITE_LANG}}")
        formatter.dateStyle = .long
        formatter.timeZone = TimeZone(secondsFromGMT: 0)
        return formatter.string(from: date)
    }

    static func iso(_ date: Date) -> String {
        String(ISO8601DateFormatter().string(from: date).prefix(10))
    }
}
